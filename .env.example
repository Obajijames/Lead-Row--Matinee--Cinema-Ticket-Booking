# ==============================================================================
# LEAD ROW - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide verified credentials. Never commit .env.

# Server Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000

# PostgreSQL Database (Primary Write)
DATABASE_URL=postgresql://leadrow_user:leadrow_password@localhost:5432/leadrow_db?schema=public&connection_limit=20

# PostgreSQL Read Replica (Optional in development / free-tier)
DATABASE_REPLICA_URL=postgresql://leadrow_user:leadrow_password@localhost:5432/leadrow_db?schema=public&connection_limit=10

# Redis Cache, Locks & Queue
REDIS_URL=redis://localhost:6379

# TMDB (The Movie Database) - BACKEND ONLY
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# Flutterwave (Test Mode Only) - BACKEND ONLY
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_public_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_secret_key
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_secret_hash_here

# JWT Authentication Secret
JWT_SECRET=lead_row_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Traffic Management & Waiting Room
WAITING_ROOM_ACTIVE_CAP=50
WAITING_ROOM_ADMISSION_RATE_PER_MIN=10
HOLD_DURATION_SECONDS=600

